    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "katex": "^0.19.1"
  }
}
