{
  "name": "crypto-lab-ntru-classic",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run test:workflow-controls && tsc && vite build",
